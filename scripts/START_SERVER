#!/usr/bin/env bash
set -euo pipefail

cd /home/jw/src/tv

# serve.py enforces HTTP Basic Auth on protected project paths (deploy/auth.env).
./scripts/restart_server

if [[ -x ./scripts/start_mkdocs_from_site.sh ]]; then
  nohup ./scripts/start_mkdocs_from_site.sh > /tmp/tv-mkdocs.log 2>&1 &
else
  echo "MkDocs helper not found. Run bash scripts/RUN_MKWIKI when needed."
fi

# systemd (preferred)
# sudo cp /home/jw/src/tv/deploy/tv-web.service /etc/systemd/system/tv-web.service
# sudo systemctl daemon-reload
# sudo systemctl enable --now tv-web.service
# systemctl status tv-web.service

