@prefix :    <http://tholonia.org/ontology/property-groups#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc:  <http://purl.org/dc/elements/1.1/> .

<http://tholonia.org/ontology/property-groups> rdf:type owl:Ontology ;
    rdfs:label "Tholonic Property Group Ontology"@en ;
    rdfs:comment "Abstract property hierarchy grouping all cognee KG relationship types via rdfs:subPropertyOf."@en ;
    dc:created "2026-05-05T14:30:05Z"^^xsd:dateTime .


# ─────────────────────────────────────────────────────────────────────────────
# Abstract super-properties
# ─────────────────────────────────────────────────────────────────────────────

:analysis
    rdf:type owl:ObjectProperty ;
    rdfs:label "analysis"@en ;
    rdfs:comment "Abstract property grouping analytical, research, and evaluative relationships. (26 sub-properties; 511 total edge uses)"@en .

:application
    rdf:type owl:ObjectProperty ;
    rdfs:label "application"@en ;
    rdfs:comment "Abstract property grouping all usage, application, and employment relationships. (31 sub-properties; 777 total edge uses)"@en .

:attribution
    rdf:type owl:ObjectProperty ;
    rdfs:label "attribution"@en ;
    rdfs:comment "Abstract property grouping attribute-assignment and property-possession relationships. (41 sub-properties; 655 total edge uses)"@en .

:authorship
    rdf:type owl:ObjectProperty ;
    rdfs:label "authorship"@en ;
    rdfs:comment "Abstract property grouping all authorship, creation, and origination relationships. (37 sub-properties; 1,101 total edge uses)"@en .

:causation
    rdf:type owl:ObjectProperty ;
    rdfs:label "causation"@en ;
    rdfs:comment "Abstract property grouping causal, dependency, and production relationships: things that cause, require, enable, or produce others. (44 sub-properties; 1,173 total edge uses)"@en .

:classification
    rdf:type owl:ObjectProperty ;
    rdfs:label "classification"@en ;
    rdfs:comment "Abstract property grouping all classification and typing relationships: instance-of, example-of, classified-as, etc. (22 sub-properties; 495 total edge uses)"@en .

:connectivity
    rdf:type owl:ObjectProperty ;
    rdfs:label "connectivity"@en ;
    rdfs:comment "Abstract property grouping structural connectivity and linkage relationships. (10 sub-properties; 300 total edge uses)"@en .

:description
    rdf:type owl:ObjectProperty ;
    rdfs:label "description"@en ;
    rdfs:comment "Abstract property grouping description, documentation, explanation, and representation relationships. (36 sub-properties; 1,032 total edge uses)"@en .

:governance
    rdf:type owl:ObjectProperty ;
    rdfs:label "governance"@en ;
    rdfs:comment "Abstract property grouping governance, regulation, constraint, and compliance relationships. (22 sub-properties; 253 total edge uses)"@en .

:measurement
    rdf:type owl:ObjectProperty ;
    rdfs:label "measurement"@en ;
    rdfs:comment "Abstract property grouping all measurement, quantification, and metric-definition relationships. (32 sub-properties; 670 total edge uses)"@en .

:parthood
    rdf:type owl:ObjectProperty ;
    rdfs:label "parthood"@en ;
    rdfs:comment "Abstract property grouping all mereological relationships: part-whole, composition, containment, and membership. (56 sub-properties; 3,338 total edge uses)"@en .

:participation
    rdf:type owl:ObjectProperty ;
    rdfs:label "participation"@en ;
    rdfs:comment "Abstract property grouping participation, affiliation, collaboration, and social relationships. (23 sub-properties; 512 total edge uses)"@en .

:provenance
    rdf:type owl:ObjectProperty ;
    rdfs:label "provenance"@en ;
    rdfs:comment "Abstract property grouping data-sourcing, provenance, and dataset-linkage relationships. (14 sub-properties; 1,198 total edge uses)"@en .

:reference
    rdf:type owl:ObjectProperty ;
    rdfs:label "reference"@en ;
    rdfs:comment "Abstract property grouping all referencing, citation, and linking relationships. (26 sub-properties; 1,072 total edge uses)"@en .

:similarity
    rdf:type owl:ObjectProperty ;
    rdfs:label "similarity"@en ;
    rdfs:comment "Abstract property grouping semantic similarity, analogy, equivalence, and alignment relationships. (35 sub-properties; 1,111 total edge uses)"@en .

:spatial
    rdf:type owl:ObjectProperty ;
    rdfs:label "spatial"@en ;
    rdfs:comment "Abstract property grouping all spatial and locational relationships: where things are, operate, or originate. (19 sub-properties; 399 total edge uses)"@en .

:support
    rdf:type owl:ObjectProperty ;
    rdfs:label "support"@en ;
    rdfs:comment "Abstract property grouping support, grounding, derivation, and foundational relationships. (25 sub-properties; 518 total edge uses)"@en .

:temporal
    rdf:type owl:ObjectProperty ;
    rdfs:label "temporal"@en ;
    rdfs:comment "Abstract property grouping all temporal and sequential relationships: ordering, transitions, and time-stamps. (18 sub-properties; 257 total edge uses)"@en .

:tholonic_ndc
    rdf:type owl:ObjectProperty ;
    rdfs:label "tholonic NDC"@en ;
    rdfs:comment "Abstract property grouping relationships specific to the Tholonic N-D-C triadic model framework. (18 sub-properties; 269 total edge uses)"@en .

:transformation
    rdf:type owl:ObjectProperty ;
    rdfs:label "transformation"@en ;
    rdfs:comment "Abstract property grouping transformation, conversion, and process-flow relationships. (20 sub-properties; 1,041 total edge uses)"@en .

