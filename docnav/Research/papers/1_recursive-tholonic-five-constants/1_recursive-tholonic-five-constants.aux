\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Left: the tholonic triad. Outer vertices carry roles $N$, $D$, $C$ with values $2^0, 2^1, 2^2$; inner midpoint vertices carry $2^3, 2^4, 2^5$. Each directed axis sums to a multiple of~$7$ (multipliers $5$, $3$, $2$). Right: the Instantiation axis multiplier $\mathrm  {istep}=2$ uniquely fixes $\Delta =4$ and the seed triple $(N_0, D_0, C_0) = (1, 3, 5)$.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:tholonic-triad}{{1}{5}{Left: the tholonic triad. Outer vertices carry roles $N$, $D$, $C$ with values $2^0, 2^1, 2^2$; inner midpoint vertices carry $2^3, 2^4, 2^5$. Each directed axis sums to a multiple of~$7$ (multipliers $5$, $3$, $2$). Right: the Instantiation axis multiplier $\mathrm {istep}=2$ uniquely fixes $\Delta =4$ and the seed triple $(N_0, D_0, C_0) = (1, 3, 5)$}{figure.1}{}}
