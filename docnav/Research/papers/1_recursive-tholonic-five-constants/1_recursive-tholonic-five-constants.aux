\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Convergence of all five branches: $\log _{10}|N_k - N_\infty |$ vs.\ $k$ at $K = 10^5$ iterations. Class~B branches reach machine precision within tens of steps; Class~C Newton--Babylonian ($\sqrt  {2}$) converges quadratically by $k \approx 6$. Class~A ($\pi /4$) and Class~C ($\ln 2$) decay as $O(1/k)$.}}{13}{figure.6}\protected@file@percent }
\newlabel{fig:convergence-comparison}{{6}{13}{Convergence of all five branches: $\log _{10}|N_k - N_\infty |$ vs.\ $k$ at $K = 10^5$ iterations. Class~B branches reach machine precision within tens of steps; Class~C Newton--Babylonian ($\sqrt {2}$) converges quadratically by $k \approx 6$. Class~A ($\pi /4$) and Class~C ($\ln 2$) decay as $O(1/k)$}{figure.6}{}}
