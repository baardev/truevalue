# TrueValue static site reverse proxy with AUBEB Basic Auth.
#
# Install target:
#   /etc/nginx/sites-available/tv-aubeb
#
# Assumptions:
#   - Python static server runs on 127.0.0.1:8000
#   - Password file exists at /etc/nginx/tv-aubeb.htpasswd
#   - DNS for tvf.tholonia.com points to this server

server {
    listen 80;
    server_name tvf.tholonia.com;

    access_log /var/log/nginx/tv-access.log;
    error_log /var/log/nginx/tv-error.log;

    # Keep the AUBEB project pages and generated data behind server-side auth.
    location ^~ /frontend/project/aubeb/ {
        auth_basic "AUBEB restricted";
        auth_basic_user_file /etc/nginx/tv-aubeb.htpasswd;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Protect viewable mirrors of AUBEB JSON, YAML, CSV, and other data files.
    location ^~ /viewable/frontend/project/aubeb/ {
        auth_basic "AUBEB restricted";
        auth_basic_user_file /etc/nginx/tv-aubeb.htpasswd;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything else remains public and is served by the existing Python server.
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
