# Combined Nginx virtual hosts for dev.tholonia.com and tvf.tholonia.com.
# Nginx owns public ports 80/443 and routes by Host header.

server {
    listen 80;
    server_name dev.tholonia.com;

    access_log /var/log/nginx/dev-tholonia-access.log;
    error_log /var/log/nginx/dev-tholonia-error.log;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-Host $host;
    }
}

server {
    listen 80;
    server_name tvf.tholonia.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name dev.tholonia.com;

    ssl_certificate /etc/nginx/ssl/tholonia-origin.crt;
    ssl_certificate_key /etc/nginx/ssl/tholonia-origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    access_log /var/log/nginx/dev-tholonia-access.log;
    error_log /var/log/nginx/dev-tholonia-error.log;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }
}

server {
    listen 443 ssl;
    server_name tvf.tholonia.com;

    ssl_certificate /etc/nginx/ssl/tholonia-origin.crt;
    ssl_certificate_key /etc/nginx/ssl/tholonia-origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    access_log /var/log/nginx/tvf-access.log;
    error_log /var/log/nginx/tvf-error.log;

    # Keep the AUBEB project pages and generated data behind server-side auth.
    location ^~ /frontend/project/aubeb/ {
        auth_basic "AUBEB restricted";
        auth_basic_user_file /etc/nginx/tv-aubeb.htpasswd;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Protect viewable mirrors of AUBEB JSON, YAML, CSV, and other data files.
    location ^~ /viewable/frontend/project/aubeb/ {
        auth_basic "AUBEB restricted";
        auth_basic_user_file /etc/nginx/tv-aubeb.htpasswd;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Everything else remains public and is served by the private Python backend.
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
